#layr overlay create secrets --readers root -q
#printf 'PAY_TOKEN=demo_7Hq2bK8vPq3TzR9mN4wE7yU\n' > .env
#layr overlay move secrets .env
#layr add .env; layr save -qm "Keep the payment token in the overlay"
cat .env
echo 'const KEY: &str = "demo_7Hq2bK8vPq3TzR9mN4wE7yU";' > src/pay.rs
layr add src/pay.rs && layr save -m "Add the payment client"
layr overlay list
layr remote add vault file:///srv/vault --paper-key-out /root/paper.txt
layr push vault
grep -rl demo_7Hq2 /srv/vault || echo "no plaintext token in the store"
