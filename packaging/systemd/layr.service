[Unit]
Description=layr service (root daemon for the btrfs store)
Documentation=https://github.com/ifdotpy/layr/blob/main/docs/btrfs-root-snapshots.md
After=local-fs.target
# Start after the file system that holds the store. Needed when the store is a separate mount.
RequiresMountsFor=/var/lib/layr

[Service]
Type=simple
ExecStart=/usr/local/bin/layr daemon
Restart=on-failure
# SIGTERM goes to the service only: it takes no new request and waits up to 80 s for the running
# ones (src/service.rs STOP_WAIT). Processes that still run when it exits get SIGKILL.
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
